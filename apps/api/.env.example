# Servidor
PORT=3001
CORS_ORIGIN=http://localhost:3009

# Firebase — em produção, use um projeto real e credenciais de service account
# (via GOOGLE_APPLICATION_CREDENTIALS apontando pro JSON, ou Application Default
# Credentials se rodando em Cloud Run/GCP). Em dev local, os emulators cobrem tudo.
FIREBASE_PROJECT_ID=demo-phonetrack
FIREBASE_STORAGE_BUCKET=demo-phonetrack.appspot.com

# Preencher apenas em produção (deixe em branco para usar os emulators locais)
GOOGLE_APPLICATION_CREDENTIALS=

# Emulators (dev local) — apontam o Admin SDK para o Firebase Emulator Suite
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
